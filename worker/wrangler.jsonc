// The household sync API and the spoken clips. The app itself is static and hosted elsewhere.
// Deploy: pnpm sync:deploy. The key is set once with `wrangler secret put HOUSEHOLD_KEY -c worker/wrangler.jsonc`.
{
  "name": "civic-relay-sync",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "citizenship-audio" }],
  "durable_objects": { "bindings": [{ "name": "HOUSEHOLD", "class_name": "Household" }] },
  "migrations": [{ "tag": "household", "new_sqlite_classes": ["Household"] }],
}
